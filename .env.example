# Required: Google AI Studio Gemini API Key
# Get yours at: https://aistudio.google.dev/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: External Python FastAPI (OpenCV) preprocessing service endpoint
# Locally defaults to http://127.0.0.1:8000/preprocess-receipt
# On Vercel (if not set), Module 3 automatically falls back to direct Gemini Vision mode
# PYTHON_PREPROCESS_URL=http://127.0.0.1:8000/preprocess-receipt
